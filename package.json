{
  "name": "deals-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that rates eDealinfo.com deals against current market prices using Claude Haiku with web search.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "playwright test --project=e2e",
    "test:live": "LIVE=1 playwright test --project=live",
    "lint": "eslint . && npm run lint:ext",
    "lint:ext": "web-ext lint --source-dir extension",
    "start:firefox": "web-ext run --source-dir extension --target firefox-desktop --firefox-profile ./.firefox-profile --profile-create-if-missing --keep-profile-changes --start-url https://www.edealinfo.com/d/00889523049914/GIGABYTE-M27Q2-27-inch-Widescreen-WQHD-1440p-2560-x-1440-200Hz/",
    "package":"web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "icons": "node scripts/make-icons.mjs",
    "canary": "node scripts/site-canary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.0.0",
    "jsdom": "^30.1.3",
    "web-ext": "^10.8.0"
  }
}
